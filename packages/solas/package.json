{
	"name": "@jk2908/solas",
	"version": "0.8.1",
	"description": "A Vite + React meta-framework exploring streaming, Server Components, and partial prerendering. Designed for simplicity and lightness",
	"keywords": [
		"framework",
		"ppr",
		"react",
		"rsc",
		"ssr",
		"vite"
	],
	"homepage": "https://github.com/jk2908/solas/tree/main/packages/solas#readme",
	"bugs": {
		"url": "https://github.com/jk2908/solas/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jk2908/solas.git"
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./env/rsc": {
			"types": "./dist/internal/env/rsc.d.ts",
			"import": "./dist/internal/env/rsc.js"
		},
		"./env/ssr": {
			"types": "./dist/internal/env/ssr.d.ts",
			"import": "./dist/internal/env/ssr.js"
		},
		"./env/browser": {
			"types": "./dist/internal/env/browser.d.ts",
			"import": "./dist/internal/env/browser.js"
		},
		"./router": {
			"types": "./dist/router.d.ts",
			"import": "./dist/router.js"
		},
		"./navigation": {
			"types": "./dist/navigation.d.ts",
			"import": "./dist/navigation.js"
		},
		"./prerender": {
			"types": "./dist/prerender.d.ts",
			"import": "./dist/prerender.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./utils/logger": {
			"types": "./dist/utils/logger.d.ts",
			"import": "./dist/utils/logger.js"
		},
		"./error-boundary": {
			"types": "./dist/error-boundary.d.ts",
			"import": "./dist/error-boundary.js"
		},
		"./cloudflare": {
			"types": "./dist/adapters/cloudflare/index.d.ts",
			"import": "./dist/adapters/cloudflare/index.js"
		},
		"./cloudflare/vite": {
			"types": "./dist/adapters/cloudflare/vite.d.ts",
			"import": "./dist/adapters/cloudflare/vite.js"
		},
		"./node": {
			"types": "./dist/adapters/node.d.ts",
			"import": "./dist/adapters/node.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsgo",
		"postbuild": "node scripts/measure.mjs",
		"test": "vitest run",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:watch": "vitest",
		"lint": "bunx oxlint .",
		"lint:fix": "bunx oxlint --fix .",
		"format": "bunx oxfmt --write .",
		"format:check": "bunx oxfmt --check .",
		"pack:dry": "npm pack --dry-run",
		"release:check": "npm run prepublishOnly",
		"prepublishOnly": "npm run build && npm run pack:dry"
	},
	"dependencies": {
		"@vitejs/plugin-rsc": "^0.5.36",
		"oxc-parser": "^0.134.0",
		"oxfmt": "^0.35.0",
		"path-to-regexp": "^8.3.0"
	},
	"devDependencies": {
		"@prettier/plugin-oxc": "^0.1.3",
		"@typescript/native-preview": "^7.0.0-dev.20260224.1",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/browser": "^4.1.8",
		"@vitest/browser-playwright": "^4.1.8",
		"happy-dom": "^20.10.2",
		"network-information-types": "^0.1.1",
		"oxfmt": "^0.35.0",
		"playwright": "^1.58.2",
		"typescript": "^5.9.3",
		"vite": "^8.3.3",
		"vitest": "^4.1.8",
		"vitest-browser-react": "^2.2.0"
	},
	"peerDependencies": {
		"@cloudflare/vite-plugin": "^2.0.0-beta.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-server-dom-webpack": "^19.2.4",
		"vite": "^8.0.0"
	},
	"peerDependenciesMeta": {
		"@cloudflare/vite-plugin": {
			"optional": true
		},
		"react-server-dom-webpack": {
			"optional": true
		}
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
